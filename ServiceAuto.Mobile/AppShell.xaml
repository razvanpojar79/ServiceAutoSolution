<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ServiceAuto.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ServiceAuto.Mobile.Views"
    Title="ServiceAuto.Mobile"
    BackgroundColor="#121212"
    ForegroundColor="White">

    <TabBar>
        <Tab Title="Programări" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:AppointmentsPage}" />
        </Tab>

        <Tab Title="Clienți" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:ClientsPage}" />
        </Tab>

        <Tab Title="Mașini" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate views:CarsPage}" />
        </Tab>
    </TabBar>

</Shell>