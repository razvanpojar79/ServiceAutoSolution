<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceAuto.Mobile.Views.AddServicePage"
             Title="Adaugă Serviciu"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="Detalii Serviciu" 
                   FontSize="18" TextColor="White" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Denumire Operațiune" TextColor="#AAAAAA"/>
                <Entry Text="{Binding Denumire}" 
                       Placeholder="Ex: Schimb Ulei"
                       BackgroundColor="#333" TextColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Preț (RON)" TextColor="#AAAAAA"/>
                <Entry Text="{Binding Pret}" 
                       Keyboard="Numeric"
                       BackgroundColor="#333" TextColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Durată Estimată (minute)" TextColor="#AAAAAA"/>
                <Entry Text="{Binding DurataEstimata}" 
                       Keyboard="Numeric"
                       BackgroundColor="#333" TextColor="White"/>
            </VerticalStackLayout>

            <Button Text="Salvează" 
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#512BD4" TextColor="White" 
                    Margin="0,20,0,0" HeightRequest="50"/>

            <Button Text="Anulează" 
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent" TextColor="#FF5555" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>