<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceAuto.Mobile.Views.ClientsPage"
             x:Name="ClientsListPage"
             Title="Clienți"
             BackgroundColor="#121212">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Adaugă" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Clienti}"
                    Margin="15">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <SwipeView Threshold="100">
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Șterge"
                                       BackgroundColor="#FF5555"
                                       Command="{Binding Source={x:Reference ClientsListPage}, Path=BindingContext.DeleteCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Frame BackgroundColor="#1E1E1E"
                           Padding="15"
                           Margin="0,5"
                           CornerRadius="10"
                           BorderColor="#333333">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={x:Reference ClientsListPage}, Path=BindingContext.EditCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Nume}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="16"/>
                            <Label Text="{Binding Telefon}"
                                   TextColor="#AAAAAA"
                                   FontSize="14"/>
                            <Label Text="{Binding Email}"
                                   TextColor="#888888"
                                   FontSize="12"/>
                        </VerticalStackLayout>
                    </Frame>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>