<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceAuto.Mobile.Views.AddAppointmentPage"
             Title="Programare Nouă"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <Label Text="Completează detaliile" 
                   FontSize="18" TextColor="White" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Model Mașină" TextColor="#AAAAAA"/>
                <Entry Text="{Binding NumeMasina}" 
                       Placeholder="Ex: VW Golf 5" 
                       BackgroundColor="#333" TextColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Data Dorită" TextColor="#AAAAAA"/>
                <DatePicker Date="{Binding DataSelectata}" 
                            MinimumDate="01/01/2025"
                            BackgroundColor="#333" TextColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Ora Dorită" TextColor="#AAAAAA"/>
                <TimePicker Time="{Binding OraSelectata}" 
                            BackgroundColor="#333" TextColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Descriere Problemă" TextColor="#AAAAAA"/>
                <Editor Text="{Binding DescriereProblema}" 
                        Placeholder="Ex: Schimb ulei..."
                        HeightRequest="100"
                        BackgroundColor="#333" TextColor="White"/>
            </VerticalStackLayout>

            <Button Text="Salvează Programarea" 
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#512BD4" TextColor="White" 
                    Margin="0,20,0,0" HeightRequest="50"/>

            <Button Text="Anulează" 
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent" TextColor="#FF5555" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>