<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceAuto.Mobile.Views.AddAppointmentPage"
             Title="Programare Nouă"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="Detalii Programare" 
                   FontSize="18" TextColor="White" HorizontalOptions="Center" />

            <VerticalStackLayout Spacing="5">
                <Label Text="Data Programării" TextColor="#AAAAAA"/>
                <DatePicker Date="{Binding DataSelectata}" 
                            BackgroundColor="#333" TextColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Ora" TextColor="#AAAAAA"/>
                <TimePicker Time="{Binding OraSelectata}" 
                            BackgroundColor="#333" TextColor="White"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Selectează Mașina" TextColor="#AAAAAA"/>
                <Picker ItemsSource="{Binding ListaMasini}"
                        SelectedItem="{Binding MasinaSelectata}"
                        ItemDisplayBinding="{Binding NrInmatriculare}"
                        Title="Alege mașina"
                        BackgroundColor="#333" TextColor="White" TitleColor="#888"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Serviciu Solicitat" TextColor="#AAAAAA"/>
                <Picker ItemsSource="{Binding ListaServicii}"
                        SelectedItem="{Binding ServiciuSelectat}"
                        ItemDisplayBinding="{Binding Denumire}"
                        Title="Alege serviciul"
                        BackgroundColor="#333" TextColor="White" TitleColor="#888"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Mecanic Preferat (Opțional)" TextColor="#AAAAAA"/>
                <Picker ItemsSource="{Binding ListaMecanici}"
                        SelectedItem="{Binding MecanicSelectat}"
                        ItemDisplayBinding="{Binding Nume}"
                        Title="Oricare disponibil"
                        BackgroundColor="#333" TextColor="White" TitleColor="#888"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Notă / Alte detalii" TextColor="#AAAAAA"/>
                <Editor Text="{Binding DescriereProblema}" 
                        Placeholder="Ex: Se aude un zgomot la roata stângă..."
                        HeightRequest="100"
                        BackgroundColor="#333" TextColor="White"/>
            </VerticalStackLayout>

            <Button Text="Salvează Programarea" 
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#512BD4" TextColor="White" 
                    Margin="0,20,0,0" HeightRequest="50"/>

            <Button Text="Anulează" 
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent" TextColor="#FF5555" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>