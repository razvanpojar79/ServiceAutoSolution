<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceAuto.Mobile.Views.ServicesPage"
             x:Name="ServicesListPage"
             Title="Servicii &amp; Prețuri"
             BackgroundColor="#121212">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Adaugă" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Servicii}"
                    Margin="15">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <SwipeView Threshold="100">
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Șterge"
                                       BackgroundColor="#FF5555"
                                       Command="{Binding Source={x:Reference ServicesListPage}, Path=BindingContext.DeleteCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Frame BackgroundColor="#1E1E1E"
                           Padding="15"
                           Margin="0,5"
                           CornerRadius="10"
                           BorderColor="#333333">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={x:Reference ServicesListPage}, Path=BindingContext.EditCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="{Binding Denumire}"
                                       TextColor="White"
                                       FontAttributes="Bold"
                                       FontSize="16"/>

                                <Label Text="{Binding DurataEstimata, StringFormat='Durată: {0} min'}"
                                       TextColor="#AAAAAA"
                                       FontSize="14"/>
                            </VerticalStackLayout>

                            <Label Grid.Column="1" 
                                   Text="{Binding Pret, StringFormat='{0} RON'}"
                                   TextColor="#00FF00"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>