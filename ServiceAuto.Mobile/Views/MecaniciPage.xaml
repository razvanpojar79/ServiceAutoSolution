<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceAuto.Mobile.Views.MecaniciPage"
             x:Name="MecaniciListPage"
             Title="Mecanici"
             BackgroundColor="#121212">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Adaugă" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Mecanici}"
                    Margin="15">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <SwipeView Threshold="100">
                    <SwipeView.RightItems>
                        <SwipeItems>
                            <SwipeItem Text="Șterge"
                                       BackgroundColor="#FF5555"
                                       Command="{Binding Source={x:Reference MecaniciListPage}, Path=BindingContext.DeleteCommand}"
                                       CommandParameter="{Binding .}" />
                        </SwipeItems>
                    </SwipeView.RightItems>

                    <Frame BackgroundColor="#1E1E1E"
                           Padding="15"
                           Margin="0,5"
                           CornerRadius="10"
                           BorderColor="#333333">

                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={x:Reference MecaniciListPage}, Path=BindingContext.EditCommand}"
                                CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Nume}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="16"/>

                            <Label Text="{Binding Specializare, StringFormat='Specializare: {0}'}"
                                   TextColor="#AAAAAA"
                                   FontSize="14"/>

                            <Label x:Name="LblStatus" 
                                   Text="{Binding EsteDisponibil, StringFormat='Disponibil: {0}'}"
                                   FontSize="12">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding EsteDisponibil}" Value="True">
                                        <Setter Property="TextColor" Value="#00FF00" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding EsteDisponibil}" Value="False">
                                        <Setter Property="TextColor" Value="#FF5555" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Frame>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>