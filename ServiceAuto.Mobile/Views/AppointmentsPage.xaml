<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceAuto.Mobile.Views.AppointmentsPage"
             Title="Programările Mele"
             BackgroundColor="#121212">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Adaugă" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Programari}"
                    Margin="15">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame BackgroundColor="#1E1E1E"
                       Padding="15"
                       Margin="0,5"
                       CornerRadius="10"
                       BorderColor="#333333">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding MasinaInfo}"
                               TextColor="White"
                               FontAttributes="Bold"
                               FontSize="16"/>
                        <Label Text="{Binding DenumireServiciu}"
                               TextColor="#AAAAAA"
                               FontSize="14"/>
                        <Label Text="{Binding DataOra}"
                               TextColor="#888888"
                               FontSize="12"/>
                        <Label Text="{Binding Status}"
                               TextColor="#512BD4"
                               FontSize="12"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>