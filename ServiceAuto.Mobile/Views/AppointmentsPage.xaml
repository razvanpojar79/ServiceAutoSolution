<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ServiceAuto.Mobile.Views.AppointmentsPage"
             Title="Programările Mele">

    <CollectionView ItemsSource="{Binding Programari}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" Padding="10" BackgroundColor="#F5F5F5">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="{Binding DataOra, StringFormat='{0:dd MMM yyyy HH:mm}'}" 
                               FontSize="16" FontAttributes="Bold" TextColor="Black"/>

                        <Label Text="{Binding MasinaInfo}" FontSize="14" />
                        <Label Text="{Binding DenumireServiciu}" TextColor="Blue" />

                        <Label Text="{Binding Status}" 
                               FontSize="12" TextColor="Gray" HorizontalOptions="End"/>
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>