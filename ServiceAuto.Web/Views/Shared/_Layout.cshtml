<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ServiceAuto</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-bg">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-nav border-bottom">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">ServiceAuto</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Clients" asp-action="Index">Clienți</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Cars" asp-action="Index">Mașini</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Mecanici" asp-action="Index">Mecanici</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Services" asp-action="Index">Servicii</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-controller="Programari" asp-action="Index">Programări</a>
                        </li>
                    </ul>

                    <span class="navbar-text small text-secondary d-none d-lg-inline">
                        Admin Panel
                    </span>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        <main role="main" class="app-surface p-4">
            @RenderBody()
        </main>

        <footer class="text-center small text-secondary py-4">
            © 2026 ServiceAuto
        </footer>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
