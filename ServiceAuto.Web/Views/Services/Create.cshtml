@model ServiceAuto.Shared.AppDtos.ServiciuDto
@{
    ViewData["Title"] = "Adaugă serviciu";
}

<h2>Adaugă serviciu</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Denumire</label>
        <input class="form-control" asp-for="Denumire" />
    </div>

    <div class="mb-3">
        <label class="form-label">Preț</label>
        <input class="form-control" asp-for="Pret" />
    </div>

    <div class="mb-3">
        <label class="form-label">Durată estimată (min)</label>
        <input class="form-control" asp-for="DurataEstimata" />
    </div>

    <button class="btn btn-primary" type="submit">Salvează</button>
    <a class="btn btn-secondary" asp-action="Index">Înapoi</a>
</form>
