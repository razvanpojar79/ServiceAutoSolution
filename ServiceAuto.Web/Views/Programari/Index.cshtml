@model List<ServiceAuto.Shared.AppDtos.ProgramareDto>

@{
    ViewData["Title"] = "Programări";
}

<h2>Programări</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Adaugă programare</a>
</p>

<table class="table table-dark table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Data/Ora</th>
            <th>Client</th>
            <th>Mașină</th>
            <th>Serviciu</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Id</td>
                <td>@p.DataOra</td>
                <td>@p.NumeClient</td>
                <td>@p.MasinaInfo</td>
                <td>@p.DenumireServiciu</td>
                <td>@p.Status</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@p.Id">Editează</a>

                    <form asp-action="Delete" asp-route-id="@p.Id" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger"
                                onclick="return confirm('Sigur ștergi programarea?');">
                            Șterge
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
