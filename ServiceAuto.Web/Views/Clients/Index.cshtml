@model List<ServiceAuto.Shared.AppDtos.ClientDto>

@{
    ViewData["Title"] = "Clienți";
}

<h2>Clienți</h2>

<p>
    <a class="btn btn-primary" asp-action="Create">Adaugă client</a>
</p>

@if (Model == null || Model.Count == 0)
{
    <div class="alert alert-info">Nu există clienți.</div>
}
else
{
    <table class="table table-dark table-striped">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nume</th>
                <th>Telefon</th>
                <th>Email</th>
                <th style="width: 220px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Nume</td>
                    <td>@c.Telefon</td>
                    <td>@c.Email</td>
                    <td>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@c.Id">Editează</a>

                        <form asp-action="Delete" asp-route-id="@c.Id" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                    onclick="return confirm('Sigur vrei să ștergi acest client?');">
                                Șterge
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
